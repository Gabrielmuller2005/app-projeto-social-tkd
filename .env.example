# Copie este arquivo para .env e ajuste o valor conforme o ambiente.
# .env não é versionado.

# Desenvolvimento:
#   - Dispositivo físico ou simulador iOS na mesma rede: use o IP local da SUA máquina
#     (rode `ipconfig` no Windows e procure o IPv4 do adaptador de rede em uso).
#     EXPO_PUBLIC_API_URL=http://SEU_IP_LOCAL:3000
#   - Emulador Android: 10.0.2.2 aponta para o localhost da máquina host.
#     EXPO_PUBLIC_API_URL=http://10.0.2.2:3000
#
# Produção:
#   EXPO_PUBLIC_API_URL=https://projeto-social-tkd-api.onrender.com

EXPO_PUBLIC_API_URL=http://SEU_IP_LOCAL:3000
